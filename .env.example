# Public URL of the app; OAuth redirect URIs are derived from it:
#   {TRAQEN_BASE_URL}/auth/google/callback
#   {TRAQEN_BASE_URL}/connections/github/callback
#   {TRAQEN_BASE_URL}/connections/jira/callback
TRAQEN_BASE_URL=http://localhost:8000
TRAQEN_DATABASE=traqen.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRAQEN_SESSION_SECRET=
# Encrypts stored integration tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRAQEN_ENCRYPTION_KEY=

# How stale a link may get before the background refresher re-checks it
TRAQEN_REFRESH_MINUTES=15

# Sign-in: "google", or "none" to skip it while developing. With "none",
# everyone is one local user, and TRAQEN_BASE_URL must be localhost.
TRAQEN_SIGN_IN=none

# Google sign-in, required when TRAQEN_SIGN_IN=google (Google Cloud console > APIs & Services > Credentials > OAuth client ID, "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub live state (GitHub > Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Jira live state (developer.atlassian.com > Console > OAuth 2.0 integration,
# permission: Jira API > read:jira-work)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
